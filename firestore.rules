rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque compte ne voit et ne modifie que ses propres données.
    // Vous utilisez le même compte sur vos deux téléphones : vous partagez donc le même livre.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Recettes : un ami peut les LIRE (jamais les modifier), pour voir la liste de son ami.
    // « Ami » = le propriétaire l'a dans ses amis ; s'il le retire, l'accès s'arrête aussitôt.
    match /users/{uid}/recipes/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    // Boîte aux lettres : autre exception, un autre compte peut y DÉPOSER un message (jamais lire ni modifier).
    // - une recette, seulement si le destinataire l'a dans ses amis ;
    // - une demande d'ami, avec le pseudo du destinataire (annuaire « pseudos ») ou un ancien code d'invitation valide.
    match /users/{uid}/inbox/{msg} {
      allow create: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.from == request.auth.uid
        && (
          (request.resource.data.type == "recipe"
            && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)))
          ||
          (request.resource.data.type == "friend"
            && request.resource.data.pseudo is string
            && get(/databases/$(database)/documents/pseudos/$(request.resource.data.pseudo)).data.uid == uid)
          ||
          (request.resource.data.type == "friend"
            && request.resource.data.code is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.from == uid
            && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.exp > request.time)
        );
    }

    // Pseudo public : lisible par son propriétaire et par les comptes qu'il a en amis,
    // pour qu'un changement de pseudo apparaisse aussi chez eux.
    match /profiles/{uid} {
      allow get: if request.auth != null
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30
        // photo de profil facultative : petite image (data URL) de moins de 60 000 caractères
        && (!('photo' in request.resource.data)
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 60000));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Annuaire des pseudos : pseudos/{clé} = {uid, name}. Un compte connecté peut lire un pseudo précis
    // (jamais lister l'annuaire) ; chacun ne crée, ne modifie et ne supprime que le sien.
    match /pseudos/{key} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9]{2,30}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Anciens codes d'invitation (remplacés par les pseudos le 2026-10-28, gardés le temps que les codes déjà envoyés expirent) :
    // lisibles un par un par un compte connecté qui connaît le code (jamais listés), valables 7 jours au plus, supprimables par leur créateur.
    match /invites/{code} {
      allow get: if request.auth != null && resource.data.exp > request.time;
      allow create: if request.auth != null
        && code.size() == 8
        && request.resource.data.from == request.auth.uid
        && request.resource.data.exp is timestamp
        && request.resource.data.exp < request.time + duration.value(8, 'd');
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
  }
}
